// English naming for all code artifacts (models, fields, tables/columns via @map).
// Business documentation (docs/plan-inicial-proyecto-inventario.md, section 7 — MER)
// stays in Spanish for the functional user; this file is the English translation
// of that same model. See convenciones.md, "Idioma".
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Roles and permissions (RBAC) ----------

model Role {
  id             String          @id @default(uuid())
  // ADR-22 — logical deletion: unique only among non-deleted rows (partial
  // index, migration 20260822010000, same pattern HU-04 used for
  // Supplier.taxId). A blanket @@unique would permanently block reusing a
  // role's name after it's deleted.
  name           String
  description    String?
  // Marks the one role every new user starts on and that a real "eliminar
  // rol" action reassigns orphaned users to — never itself deletable.
  // Partial unique index enforces at most one row can ever be true.
  isDefault      Boolean         @default(false) @map("is_default")
  deletedAt      DateTime?       @map("deleted_at")
  users          User[]
  permissions    RolePermission[]
  approvalFlows  ApprovalFlow[]

  @@map("role")
}

model Permission {
  id      String            @id @default(uuid())
  module  String
  action  String
  roles   RolePermission[]

  @@unique([module, action])
  @@map("permission")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permission")
}

enum UserStatus {
  active
  blocked
}

model User {
  id                String                @id @default(uuid())
  name              String
  email             String                @unique
  passwordHash      String                @map("password_hash")
  roleId            String                @map("role_id")
  role              Role                  @relation(fields: [roleId], references: [id])
  status            UserStatus            @default(active)
  createdAt         DateTime              @default(now()) @map("created_at")
  movements         InventoryMovement[]
  purchases         Purchase[]
  requestsCreated   Request[]             @relation("requester")
  requestApprovals  RequestApproval[]
  auditEvents       AuditEvent[]
  errorEvents       ErrorEvent[]

  @@index([roleId])
  @@map("user")
}

// ---------- Locations ----------

enum LocationStatus {
  active
  inactive
}

model Location {
  id             String              @id @default(uuid())
  name           String
  parentId       String?             @map("parent_id")
  parent         Location?           @relation("hierarchy", fields: [parentId], references: [id])
  children       Location[]          @relation("hierarchy")
  status         LocationStatus      @default(active)
  stock          LocationStock[]
  movements      InventoryMovement[]
  purchaseItems  PurchaseItem[]
  requestItems   RequestItem[]

  // HU-06: unique name per parent. Postgres treats each NULL parent_id as
  // distinct, so this does NOT dedupe root-level (parentId null) names on
  // its own — CreateLocationUseCase/UpdateLocationUseCase additionally
  // check for a root-level name collision before insert/update.
  @@unique([parentId, name])
  @@index([parentId])
  @@map("location")
}

// ---------- Catalog and inventory ----------

// Administrable catalogs (TT-23, ADR-23) — Category/Unit are real tables,
// not free text on Product, so an Inventory Admin can manage them (add,
// rename, deactivate) without a Product being tied to a typo-prone string.
enum CategoryStatus {
  active
  inactive
}

model Category {
  id       String         @id @default(uuid())
  name     String         @unique
  status   CategoryStatus @default(active)
  products Product[]

  @@map("category")
}

enum UnitStatus {
  active
  inactive
}

model Unit {
  id       String     @id @default(uuid())
  name     String     @unique
  status   UnitStatus @default(active)
  products Product[]

  @@map("unit")
}

enum ProductStatus {
  active
  discontinued
}

model Product {
  id            String              @id @default(uuid())
  name          String
  description   String?
  unitId        String              @map("unit_id")
  unit          Unit                @relation(fields: [unitId], references: [id])
  categoryId    String?             @map("category_id")
  category      Category?           @relation(fields: [categoryId], references: [id])
  requiresBatch Boolean             @default(false) @map("requires_batch")
  imageUrl      String?             @map("image_url") // HU-26, post-MVP
  status        ProductStatus       @default(active)
  batches       Batch[]
  stock         LocationStock[]
  minimumStock  MinimumStock?
  movements     InventoryMovement[]
  purchaseItems PurchaseItem[]
  requestItems  RequestItem[]

  @@index([unitId])
  @@index([categoryId])
  @@map("product")
}

model Batch {
  id           String              @id @default(uuid())
  productId    String              @map("product_id")
  product      Product             @relation(fields: [productId], references: [id])
  batchNumber  String              @map("batch_number")
  expiresAt    DateTime?           @map("expires_at")
  receivedAt   DateTime            @default(now()) @map("received_at")
  stock        LocationStock[]
  movements    InventoryMovement[]
  purchaseItems PurchaseItem[]

  @@index([productId])
  @@map("batch")
}

// Derived table — NOT the source of truth. Updated together with
// InventoryMovement in the same transaction (see section 7.3 of the plan).
model LocationStock {
  id          String    @id @default(uuid())
  productId   String    @map("product_id")
  product     Product   @relation(fields: [productId], references: [id])
  locationId  String    @map("location_id")
  location    Location  @relation(fields: [locationId], references: [id])
  batchId     String?   @map("batch_id")
  batch       Batch?    @relation(fields: [batchId], references: [id])
  quantity    Decimal   @default(0) @db.Decimal(14, 4)
  // optimistic locking (TT-17, ADR-20) — incremented on every successful
  // update; concurrent writers detect a lost update via a version mismatch
  version     Int       @default(0)

  @@unique([productId, locationId, batchId])
  // the unique index above covers productId and productId+locationId
  // lookups (leftmost prefix); this covers "all stock at this location,
  // any product" (HU-10), which it doesn't
  @@index([locationId])
  @@map("location_stock")
}

// HU-11 — a single threshold per product, not per product+location (DoR
// resolved by the user, diverges from the original MER which scoped this
// per product+location): the alert (HU-12) compares this against the SUM
// of LocationStock.quantity across every location/batch of that product,
// not any one location's quantity in isolation.
model MinimumStock {
  id               String    @id @default(uuid())
  productId        String    @unique @map("product_id")
  product          Product   @relation(fields: [productId], references: [id])
  minimumQuantity  Decimal   @map("minimum_quantity") @db.Decimal(14, 4)

  @@map("minimum_stock")
}

enum MovementType {
  in
  out
  transfer_in
  transfer_out
  adjustment
}

// Immutable ledger — the source of truth for inventory.
model InventoryMovement {
  id          String        @id @default(uuid())
  productId   String        @map("product_id")
  product     Product       @relation(fields: [productId], references: [id])
  locationId  String        @map("location_id")
  location    Location      @relation(fields: [locationId], references: [id])
  batchId     String?       @map("batch_id")
  batch       Batch?        @relation(fields: [batchId], references: [id])
  type        MovementType
  quantity    Decimal       @db.Decimal(14, 4)
  userId      String        @map("user_id")
  user        User          @relation(fields: [userId], references: [id])
  purchaseId  String?       @map("purchase_id")
  purchase    Purchase?     @relation(fields: [purchaseId], references: [id])
  requestId   String?       @map("request_id")
  request     Request?      @relation(fields: [requestId], references: [id])
  occurredAt  DateTime      @default(now()) @map("occurred_at")
  notes       String?

  // the ledger — biggest table, most-queried, so it gets the most
  // deliberate indexing (TT-20): history for a product at a location
  // (HU-08/HU-10) is the main access pattern, then date-range reports,
  // then each remaining FK for its own lookup (by batch, by user who
  // registered it, by the purchase/request that triggered it)
  @@index([productId, locationId])
  @@index([occurredAt])
  @@index([batchId])
  @@index([userId])
  @@index([purchaseId])
  @@index([requestId])
  @@map("inventory_movement")
}

// ---------- Suppliers and purchases ----------

enum SupplierStatus {
  active
  inactive
}

enum DocumentTypeStatus {
  active
  inactive
}

// HU-04, at the user's explicit request: an administrable catalog (TT-23
// pattern, like Category/Unit) instead of a hardcoded enum — CC/CE/NIT is
// a fixed starter set (seeded), but not closed: an admin can add more
// (e.g. Pasaporte) from the /document-types screen without a deploy.
model DocumentType {
  id        String             @id @default(uuid())
  name      String             @unique
  status    DocumentTypeStatus @default(active)
  suppliers Supplier[]

  @@map("document_type")
}

enum PersonTypeStatus {
  active
  inactive
}

// HU-04, at the user's explicit request: Natural/Jurídica as an
// administrable catalog, same reasoning as DocumentType above.
model PersonType {
  id        String           @id @default(uuid())
  name      String           @unique
  status    PersonTypeStatus @default(active)
  suppliers Supplier[]

  @@map("person_type")
}

model Supplier {
  id             String          @id @default(uuid())
  name           String
  // HU-04: no duplicate taxId among ACTIVE suppliers **of the same
  // document type** — a Cédula and a NIT with the same digits are two
  // different real-world identifiers, not a collision. Enforced by a
  // partial unique index on (document_type_id, tax_id) filtered
  // `WHERE status = 'active'`, added by migration
  // 20260819040000_add_supplier_tax_id_active_unique. Prisma's schema DSL
  // has no partial-index syntax, so it can't be declared here as
  // `@@unique` — CreateSupplierUseCase/UpdateSupplierUseCase check it
  // explicitly; the DB index is only the race-condition safety net (and
  // only covers races where documentTypeId is set — see the migration's
  // comment for why a race with it omitted relies on the app check alone,
  // same accepted gap as HU-06's parentId). Both documentTypeId and taxId
  // are optional (only `name` is required per HU-04's criteria), so the
  // check/index only fire when both are set.
  taxId          String?         @map("tax_id")
  documentTypeId String?         @map("document_type_id")
  documentType   DocumentType?   @relation(fields: [documentTypeId], references: [id])
  personTypeId   String?         @map("person_type_id")
  personType     PersonType?     @relation(fields: [personTypeId], references: [id])
  contact        String?
  phone          String?
  email          String?
  status         SupplierStatus  @default(active)
  purchases      Purchase[]
  requests       Request[]

  @@index([documentTypeId])
  @@index([personTypeId])
  @@map("supplier")
}

enum PurchaseStatus {
  registered
  received
}

model Purchase {
  id          String                @id @default(uuid())
  supplierId  String                @map("supplier_id")
  supplier    Supplier              @relation(fields: [supplierId], references: [id])
  userId      String                @map("user_id")
  user        User                  @relation(fields: [userId], references: [id])
  purchasedAt DateTime              @default(now()) @map("purchased_at")
  status      PurchaseStatus        @default(registered)
  items       PurchaseItem[]
  movements   InventoryMovement[]
  // HU-17 — back-reference only, no scalar/FK here: Request.purchaseId is
  // the owning side (set once, when the inventory admin integrates an
  // approved purchase request).
  request     Request?

  @@index([supplierId, purchasedAt])
  @@index([userId])
  @@map("purchase")
}

model PurchaseItem {
  id         String    @id @default(uuid())
  purchaseId String    @map("purchase_id")
  purchase   Purchase  @relation(fields: [purchaseId], references: [id])
  productId  String    @map("product_id")
  product    Product   @relation(fields: [productId], references: [id])
  // HU-13, at the user's explicit request: destination location chosen per
  // item, not once for the whole purchase (a single delivery can restock
  // more than one location). batchId is set by RegisterPurchaseUseCase —
  // never accepted as a raw id from the client: the request DTO carries a
  // human-entered batchNumber, looked up (and created if missing) within
  // the same transaction as the movement, same "receiving creates the lot"
  // workflow real purchasing follows (contrast with HU-08/09's batchId,
  // which references a batch that must already exist).
  locationId String    @map("location_id")
  location   Location  @relation(fields: [locationId], references: [id])
  batchId    String?   @map("batch_id")
  batch      Batch?    @relation(fields: [batchId], references: [id])
  quantity   Decimal   @db.Decimal(14, 4)
  unitPrice  Decimal   @map("unit_price") @db.Decimal(14, 2) // input for HU-14

  @@index([purchaseId])
  @@index([productId])
  @@index([locationId])
  @@index([batchId])
  @@map("purchase_item")
}

// ---------- Requests ----------

enum RequestType {
  purchase
  consumption
}

// HU-15/16/17 — DoR resolved with the user, diverges from the original
// 4-value enum. Purchase requests use the fuller cycle: draft (saved, not
// submitted) -> pending -> in_review (some approvals collected, quorum not
// reached) -> pending_inventory_integration (quorum reached — jumps here
// directly, "approved" is never a resting value: the user confirmed
// reaching quorum is fully automatic, no manual step in between) -> closed
// (integrated by the inventory admin). A rejection from ANY approver, at
// any point before quorum, closes the request directly too — purchase
// never rests at "rejected" either, same "no manual step in between"
// reasoning; which approver rejected and why lives on RequestApproval, not
// Request.status. Consumption requests only ever use pending -> in_review
// -> closed: reaching quorum executes the real "out" movement and jumps
// straight to closed (never rests at "approved"); a rejection also jumps
// straight to closed (never rests at "rejected"). "approved"/"rejected"
// stay in this enum only because RequestApprovalDecision needs the same
// two concepts at the per-approver level — Request.status itself never
// stores either value under the confirmed design.
enum RequestStatus {
  draft
  pending
  in_review
  approved
  rejected
  pending_inventory_integration
  closed
}

// HU-17 — one row per approver who voted on a request, at the user's
// explicit request: parallel multi-approval (any of the required approvers
// can cast one of the needed votes, not a strict sequence), so a single
// Request.approverId/resolvedAt-by-one-person field (the original design)
// can't represent it. @@unique prevents the same person voting twice on
// the same request — a second real attempt is a 409, not a second row.
enum RequestApprovalDecision {
  approved
  rejected
}

model RequestApproval {
  id         String                  @id @default(uuid())
  requestId  String                  @map("request_id")
  request    Request                 @relation(fields: [requestId], references: [id])
  approverId String                  @map("approver_id")
  approver   User                    @relation(fields: [approverId], references: [id])
  decision   RequestApprovalDecision
  // Optional on approval, mandatory on rejection (enforced by
  // RejectRequestDto, not the DB — same "app validates, DB just stores"
  // split as everywhere else in this schema) — the user's explicit
  // requirement: a rejection must always carry a reason, shown to the
  // requester when they view their own request.
  comment    String?
  decidedAt  DateTime                @default(now()) @map("decided_at")

  @@unique([requestId, approverId])
  @@index([requestId])
  @@map("request_approval")
}

model Request {
  id           String                @id @default(uuid())
  type         RequestType
  requesterId  String                @map("requester_id")
  requester    User                  @relation("requester", fields: [requesterId], references: [id])
  // HU-15, DoR resolved by the user: the requester picks the supplier when
  // creating a purchase request (not the approver, not at integration
  // time) — mirrors Purchase.supplierId, one supplier per request. Never
  // set for type = consumption.
  supplierId   String?               @map("supplier_id")
  supplier     Supplier?             @relation(fields: [supplierId], references: [id])
  status       RequestStatus         @default(pending)
  // TT-17/ADR-20 optimistic locking — HU-17's parallel approvals are the
  // first writer here with a real concurrent-update risk (two approvers
  // racing to be the vote that reaches quorum); withOptimisticLock retries
  // the whole read-count-decide-write attempt on a version mismatch, same
  // pattern as LocationStock.
  version      Int                   @default(0)
  // HU-17 — set once, by IntegrateRequestUseCase, when the inventory admin
  // turns an approved purchase request into a real Purchase (reusing
  // RegisterPurchaseUseCase from HU-13). @unique doubles as a cheap guard
  // against integrating the same request twice.
  purchaseId   String?               @unique @map("purchase_id")
  purchase     Purchase?             @relation(fields: [purchaseId], references: [id])
  createdAt    DateTime              @default(now()) @map("created_at")
  resolvedAt   DateTime?             @map("resolved_at")
  notes        String?
  items        RequestItem[]
  movements    InventoryMovement[]
  approvals    RequestApproval[]

  @@index([requesterId])
  @@index([supplierId])
  @@map("request")
}

model RequestItem {
  id               String    @id @default(uuid())
  requestId        String    @map("request_id")
  request          Request   @relation(fields: [requestId], references: [id])
  productId        String    @map("product_id")
  product          Product   @relation(fields: [productId], references: [id])
  locationId       String    @map("location_id")
  location         Location  @relation(fields: [locationId], references: [id])
  quantity         Decimal   @db.Decimal(14, 4)
  estimatedPrice   Decimal?  @map("estimated_price") @db.Decimal(14, 2)

  @@index([requestId])
  @@map("request_item")
}

// Configurable — supports 1 or several levels without a schema migration
// (HU-18, post-MVP: real sequential levels). HU-17, at the user's explicit
// request, only ever writes level = 1 rows for now: parallel quorum among
// whoever holds requests:approve, not a level-by-level sequence yet.
model ApprovalFlow {
  id                String       @id @default(uuid())
  requestType       RequestType  @map("request_type")
  level             Int
  roleId            String       @map("role_id")
  role              Role         @relation(fields: [roleId], references: [id])
  // HU-17 — first real consumer of this table: how many distinct approvals
  // are needed before a request of this type resolves. Parametrizable per
  // the user's explicit request ("a hoy pueden ser 2 a futuro 3 o 1") — no
  // admin UI to manage ApprovalFlow rows exists yet, so
  // ApproveRequestUseCase falls back to 2 when no row exists for a given
  // requestType (documented there, not here).
  requiredApprovals Int          @default(2) @map("required_approvals")

  @@map("approval_flow")
}

// ---------- Audit (HU-23) ----------

model AuditEvent {
  id     String  @id @default(uuid())
  // Nullable: a failed login against an email that doesn't match any user
  // has no real userId to attach — the attempted email goes in entityId
  // instead (see RecordAuditEventUseCase). Every other action always has a
  // real actor.
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])
  action String
  entity String
  entityId   String   @map("entity_id")
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([userId])
  @@index([entity, entityId])
  @@index([occurredAt])
  @@map("audit_event")
}

// HU-31, at the user's explicit request: a dedicated table, separate from
// AuditEvent — an error isn't "a user's action on an entity" (AuditEvent's
// shape), it's a failure of a request. Recorded by GlobalExceptionFilter
// (TT-15) for every error response, 4xx and 5xx alike, so it doubles as
// the panel to answer "what's actually failing and where" — module/action
// come from the same @RequirePermission() metadata PermissionsGuard
// already reads (via Reflector), null when the failing route doesn't
// carry one (e.g. a public route, or a plain 401 from a missing/invalid
// token before any handler metadata is even reached).
model ErrorEvent {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  module     String?
  action     String?
  method     String
  path       String
  statusCode Int      @map("status_code")
  message    String
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([module, action])
  @@index([statusCode])
  @@index([occurredAt])
  @@map("error_event")
}

// ---------- Idempotency (TT-18) ----------

// Backs the @Idempotent() decorator / IdempotencyInterceptor pattern
// (backend/src/common/): a duplicate request with the same key returns the
// already-stored response instead of re-executing the handler. See ADR-21.
model IdempotencyKey {
  id        String   @id @default(uuid())
  key       String   @unique
  endpoint  String
  response  Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("idempotency_key")
}

// ADR-32 — POST /auth/logout support: a JWT is stateless (ADR-24), so
// invalidating one before its natural expiry means storing its jti here
// until then. JwtStrategy checks every authenticated request against this
// table. No cleanup job needed — same reasoning as IdempotencyKey: rows
// become irrelevant once expiresAt passes, since the JWT itself would fail
// signature/expiry validation by then regardless of this table's contents.
model RevokedToken {
  jti       String   @id
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("revoked_token")
}
