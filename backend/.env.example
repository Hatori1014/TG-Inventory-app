# Copy to .env and fill in. Never commit the real .env (see HU-19 / secrets rule, sections 4.7 and 8.1)

# Local database (docker-compose) or Neon/Supabase in staging/production (TT-05)
# Connection pool params (TT-16, see TRD.md): explicit connection_limit instead of
# Prisma's host-dependent default; pool_timeout/connect_timeout tuned for Neon's
# cold start; statement_timeout (via `options`, the standard libpq mechanism) caps
# how long a single query can hold a connection. Same params used locally so dev
# behavior matches staging/production.
DATABASE_URL="postgresql://dev:dev@localhost:5432/inventario_dev?schema=public&connection_limit=5&pool_timeout=10&connect_timeout=10&options=-c%20statement_timeout%3D10000"
# In Render (TT-04)/staging, use the Neon connection string with the same suffix, e.g.:
# DATABASE_URL="postgresql://<user>:<pass>@<neon-host>/<db>?sslmode=require&connection_limit=5&pool_timeout=10&connect_timeout=10&options=-c%20statement_timeout%3D10000"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"

# HU-01 seed (npm run prisma:seed / prisma:seed:staging) — creates the first
# admin user, since there is no "register" story yet. Set these yourself
# before seeding; the script refuses to run without them and never generates
# or logs a password on its own.
SEED_ADMIN_EMAIL="admin@tg-group.local"
SEED_ADMIN_PASSWORD=""

# App
PORT=3000
NODE_ENV="development"

# CORS (main.ts reads this; falls back to http://localhost:4200 if unset)
# In Render, set this to the deployed Vercel frontend URL, e.g. https://tg-inventory-app.vercel.app
FRONTEND_URL="http://localhost:4200"

# Cloudflare R2 (only needed for MVP 5 — HU-26/27, post-MVP)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
