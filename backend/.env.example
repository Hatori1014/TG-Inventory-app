# Copy to .env and fill in. Never commit the real .env (see HU-19 / secrets rule, sections 4.7 and 8.1)

# Local database (docker-compose) or Neon/Supabase in staging/production (TT-05)
DATABASE_URL="postgresql://dev:dev@localhost:5432/inventario_dev?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"

# App
PORT=3000
NODE_ENV="development"

# Cloudflare R2 (only needed for MVP 5 — HU-26/27, post-MVP)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
